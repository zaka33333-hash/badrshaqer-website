---
import Base from '../../layouts/Base.astro';
import ConsultationPage from '../../components/ConsultationPage.astro';
import { inner } from '../../data/copy/inner.js';
import { PATHS } from '../../data/site.js';
import { serviceLd } from '../../data/ld.js';
import '../../styles/inner.css';
import '../../styles/home.css';
const lang = 'ar';
const t = inner.consultation[lang];
const ld = serviceLd(lang);
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alt={PATHS.consultation} jsonLd={[ld]} firstTheme="dark">
  <ConsultationPage lang={lang}  />
  <script src="../../scripts/inner.js"></script>
</Base>
