---
import Base from '../../../layouts/Base.astro';
import StoryPage from '../../../components/StoryPage.astro';
import { inner } from '../../../data/copy/inner.js';
import { PATHS } from '../../../data/site.js';
import { profileLd } from '../../../data/ld.js';
import '../../../styles/inner.css';

const lang = 'en';
const t = inner.story[lang];
const ld = profileLd(lang);
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alt={PATHS.story} jsonLd={[ld]} firstTheme="dark">
  <StoryPage lang={lang}  />
  <script src="../../../scripts/inner.js"></script>
</Base>
