---
import Base from '../../../layouts/Base.astro';
import ProgramPage from '../../../components/ProgramPage.astro';
import { inner } from '../../../data/copy/inner.js';
import { PATHS } from '../../../data/site.js';
import { courseLd } from '../../../data/ld.js';
import '../../../styles/inner.css';

const lang = 'ar';
const t = inner.programs.systemize[lang];
const ld = courseLd(lang, 'systemize');
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alt={PATHS.programSystemize} jsonLd={[ld]} firstTheme="dark">
  <ProgramPage lang={lang} program="systemize" />
  <script src="../../../scripts/inner.js"></script>
</Base>
