---
import Base from '../../layouts/Base.astro';
import ArticlesPage from '../../components/ArticlesPage.astro';
import { inner } from '../../data/copy/inner.js';
import { PATHS } from '../../data/site.js';
import { collectionLd } from '../../data/ld.js';
import '../../styles/inner.css';

const lang = 'ar';
const t = inner.articles[lang];
const ld = collectionLd(lang);
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alt={PATHS.articles} jsonLd={[ld]} firstTheme="dark">
  <ArticlesPage lang={lang}  />
  <script src="../../scripts/inner.js"></script>
</Base>
