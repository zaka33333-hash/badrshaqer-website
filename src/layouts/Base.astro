---
/**
 * Base layout — shared shell for every page, both languages.
 * Handles: SEO (canonical, hreflang, OG/Twitter, JSON-LD), fonts,
 * loader, pill nav, full-screen menu, cursor, outro footer.
 */
import { SITE, PATHS, other } from '../data/site.js';
import { orgLd } from '../data/ld.js';
import { shared } from '../data/copy/shared.js';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import { ClientRouter } from 'astro:transitions';

import '../styles/tokens.css';
import '../styles/fonts/shared.css';
import '../styles/fonts/ar.css';
import '../styles/fonts/en.css';
import '../styles/fonts/general-sans.css';
import '../styles/base.css';
import '../styles/shell.css';
import '../styles/elevate.css';

const {
  lang = 'ar',
  title,
  description,
  alt, // { ar: '/path/', en: '/en/path/' }
  ogImage,
  jsonLd = [],
  firstTheme = 'dark',
  noFooterCtas = false,
} = Astro.props;

const t = shared[lang];
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const base = import.meta.env.BASE_URL; // deploy base, ends with '/'
const canonical = `${SITE.domain}${alt[lang]}`;
// language toggle — links to the same page in the other language
const altLang = other(lang);
const langSwitch = {
  href: alt[altLang],
  label: altLang.toUpperCase(),
  aria: altLang === 'ar' ? 'العربية' : 'English',
};
const og = ogImage || `${SITE.domain}${base}assets/og-${lang}.jpg`;

const personLd = {
  '@type': 'Person',
  '@id': `${SITE.domain}/#badr`,
  name: lang === 'ar' ? 'بدر شاكر' : 'Badr Shaqer',
  alternateName: lang === 'ar' ? 'Badr Shaqer' : 'بدر شاكر',
  jobTitle: lang === 'ar' ? 'مستشار المؤسسين' : 'Founder Advisor',
  url: SITE.domain + PATHS.home[lang],
  image: `${SITE.domain}${base}assets/badr-portrait.webp`,
  sameAs: [SITE.instagram, SITE.x, SITE.tiktok, SITE.almobadir],
  knowsAbout:
    lang === 'ar'
      ? ['ريادة الأعمال', 'المبيعات', 'التسويق', 'نمو الإيرادات']
      : ['Entrepreneurship', 'Sales', 'Marketing', 'Revenue growth'],
};
const websiteLd = {
  '@type': 'WebSite',
  url: `${SITE.domain}${base}`,
  name: lang === 'ar' ? 'بدر شاكر · مستشار المؤسسين' : 'Badr Shaqer · Founder Advisor',
  inLanguage: lang,
};

// Auto breadcrumb: Home › current page, on every page except home. Page name
// is the title minus its " · بدر شاكر / · Badr Shaqer" suffix.
const isHome = alt[lang] === PATHS.home[lang];
const crumbName = (title || '').split('·')[0].trim();
const breadcrumbLd = isHome
  ? null
  : {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.nav.home, item: `${SITE.domain}${PATHS.home[lang]}` },
        { '@type': 'ListItem', position: 2, name: crumbName, item: canonical },
      ],
    };

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [personLd, websiteLd, orgLd(), ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd],
};
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0b07" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script>document.documentElement.classList.add('js');</script>
    <ClientRouter />

    {/* critical display-font subsets — keep in sync with src/styles/fonts/*.css */}
    {lang === 'ar' ? (
      <>
        <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}fonts/reemkufi_v28_2sDcZGJLip7W2J7v7wQzbWW5Kb8VZBHR.woff2`} />
        <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}fonts/alexandria_v6_UMBXrPdDqW66y0Y2usFeaijdA5E64BdCIg.woff2`} />
      </>
    ) : (
      <>
        <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}fonts/generalsans-600.woff2`} />
        <link rel="preload" as="font" type="font/woff2" crossorigin href={`${base}fonts/generalsans-400.woff2`} />
      </>
    )}

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}assets/favicon/favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}assets/favicon/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest-${lang}.webmanifest`} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={`${SITE.domain}${alt.ar}`} />
    <link rel="alternate" hreflang="en" href={`${SITE.domain}${alt.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.domain}${alt.ar}`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
  </head>

  <body data-bg={firstTheme}>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <div class="page-wipe" transition:persist="page-wipe" aria-hidden="true"></div>

    <div class="loader" id="loader" aria-hidden="true">
      <p class="loader__name" aria-hidden="true">
        <span style="--d:80ms">{t.nameSplit[0]}</span>{' '}
        <span style="--d:200ms"><em>{t.nameSplit[1]}.</em></span>
      </p>
      <span class="loader__pct">0%</span>
      <div class="loader__line"></div>
    </div>

    <div class="scroll-progress" aria-hidden="true"></div>

    <button
      class="menu-toggle"
      id="menuToggle"
      aria-expanded="false"
      aria-controls="menuPanel"
      aria-label={t.nav.menuOpen}
    >
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-toggle__text">{t.nav.menuLabel}</span>
    </button>

    <nav class="menu-panel" id="menuPanel" aria-label={t.a11y.mainMenu}>
      <div class="menu-panel__links">
        {t.menu.map((item) => (
          <a
            href={item.href}
            aria-current={item.href === alt[lang] ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          ><span>{item.label}</span></a>
        ))}
      </div>
      <div class="menu-panel__foot">
        <a class="cta cta--primary" href={t.menuCta.href} target="_blank" rel="noopener noreferrer" data-cursor-style="button" data-cursor="BOOK">
          <span>{t.menuCta.label}</span>
          <span class="cta__arrow"><Arrow /></span>
        </a>
        <span class="t-mono">
          <a href={alt[t.langSwitch.lang]} lang={t.langSwitch.lang} hreflang={t.langSwitch.lang}>{t.langSwitch.label}</a>
          <a href={`mailto:${SITE.email}`} data-copy-email={SITE.email} data-copied-label={t.emailCopied} data-cursor="COPY"><span>{SITE.email}</span></a>
        </span>
      </div>
    </nav>

    <nav class="pillnav" aria-label={lang === 'ar' ? 'تنقل' : 'Navigation'} transition:persist transition:name="pillnav">
      <a class="pillnav__link" href={t.nav.story.href}>{t.nav.story.label}</a>
      <a class="pillnav__logo" href={PATHS.home[lang]} aria-label={t.nav.home}>
        <img src={`${base}assets/badr-portrait.webp`} alt="" width="46" height="46" loading="eager" />
      </a>
      <a class="pillnav__link" href={t.nav.programs.href}>{t.nav.programs.label}</a>
    </nav>

    <nav class="contact-pills" aria-label={t.a11y.contact} transition:persist transition:name="contact-pills">
      {t.pills.map((p) => (
        p.langSwitch ? (
          <a
            class="contact-pills__lang"
            href={langSwitch.href}
            hreflang={altLang}
            lang={altLang}
            aria-label={langSwitch.aria}
            data-cursor={langSwitch.label}
          ><span>{langSwitch.label}</span></a>
        ) : (
          <a
            href={p.href}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener noreferrer' : undefined}
            data-cursor={p.cursor}
            data-copy-email={p.copyEmail ? SITE.email : undefined}
            data-copied-label={p.copyEmail ? t.emailCopied : undefined}
          ><span>{p.label}</span></a>
        )
      ))}
    </nav>

    <div class="cursor" id="cursor" aria-hidden="true" transition:persist transition:name="cursor">
      <span class="cursor__label" id="cursorLabel"></span>
      <img src="" alt="" class="cursor__img" id="cursorImg" />
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} noCtas={noFooterCtas} />

    <script src="../scripts/core.js"></script>
    <script>import '../scripts/transitions.js';</script>
  </body>
</html>
