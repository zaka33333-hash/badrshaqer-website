---
import SegHead from './SegHead.astro';
const { overline, head, deck, deckStrong, ghost, tall = false, photo } = Astro.props;
---
<section class:list={['pagehero', 'stage', { 'pagehero--tall': tall, 'pagehero--photo': !!photo }]} data-theme="dark">
  {photo && (
    <div class="pagehero__backdrop" aria-hidden="true">
      <img src={photo} alt="" fetchpriority="high" />
    </div>
  )}
  <div class="wrap">
    <p class="pagehero__overline t-mono" data-reveal="fade">{overline}</p>
    <h1 class="t-display pagehero__head split-mask">
      <SegHead segments={head} />
    </h1>
    {deck && (
      <p class="pagehero__deck" data-reveal="rise-slow" style="--delay:250ms">
        {deck} {deckStrong && <strong>{deckStrong}</strong>}
      </p>
    )}
    <slot />
  </div>
</section>
